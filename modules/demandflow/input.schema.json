{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DemandFlow 输入 Schema V0.1 (设计稿)",
  "description": "DemandFlow 专属输入。当前为设计阶段，Schema 用于验证标准兼容性。",
  "type": "object",
  "required": ["historical_demand", "current_inventory"],
  "properties": {
    "historical_demand": {
      "type": "array",
      "minItems": 1,
      "description": "历史需求记录",
      "items": {
        "type": "object",
        "required": ["sku_id", "date", "quantity"],
        "properties": {
          "sku_id": { "type": "string", "description": "SKU 编号" },
          "date": { "type": "string", "format": "date" },
          "quantity": { "type": "integer", "minimum": 0 },
          "is_promotion": { "type": "boolean", "default": false },
          "price": { "type": "number", "minimum": 0 },
          "notes": { "type": "string", "description": "业务事件标注（断货/爆款/异常等）" }
        }
      }
    },
    "current_inventory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sku_id", "quantity_on_hand"],
        "properties": {
          "sku_id": { "type": "string" },
          "quantity_on_hand": { "type": "integer", "minimum": 0 },
          "quantity_reserved": { "type": "integer", "minimum": 0, "default": 0 },
          "safety_stock": { "type": "integer", "minimum": 0 },
          "warehouse_id": { "type": "string" },
          "last_updated": { "type": "string", "format": "date" }
        }
      }
    },
    "forecast_config": {
      "type": "object",
      "properties": {
        "horizon_days": { "type": "integer", "minimum": 1, "default": 30 },
        "granularity": { "type": "string", "enum": ["daily", "weekly", "monthly"], "default": "daily" },
        "confidence_level": { "type": "number", "minimum": 0.5, "maximum": 0.99, "default": 0.8 }
      }
    },
    "events": {
      "type": "object",
      "description": "已知的未来业务事件",
      "properties": {
        "promotions": { "type": "array", "items": { "type": "object" } },
        "holidays": { "type": "array", "items": { "type": "string", "format": "date" } },
        "new_product_launch": { "type": "boolean", "default": false }
      }
    },
    "supplier_info": {
      "type": "array",
      "description": "供应商交期信息，用于联动补货建议",
      "items": {
        "type": "object",
        "properties": {
          "sku_id": { "type": "string" },
          "supplier_id": { "type": "string" },
          "lead_time_days": { "type": "integer", "minimum": 0 },
          "moq": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
