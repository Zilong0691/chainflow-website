{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RouteFlow 输入 Schema V0.1",
  "description": "RouteFlow 专属输入字段。该对象放在统一请求的 data 字段中。",
  "type": "object",
  "required": ["orders", "depot", "vehicles"],
  "properties": {
    "orders": {
      "type": "array",
      "minItems": 1,
      "description": "待配送订单列表",
      "items": {
        "type": "object",
        "required": ["id", "lat", "lng"],
        "properties": {
          "id": { "type": "string", "description": "订单编号" },
          "delivery_address": { "type": "string", "description": "收货地址文本" },
          "lat": { "type": "number", "minimum": -90, "maximum": 90 },
          "lng": { "type": "number", "minimum": -180, "maximum": 180 },
          "weight_kg": { "type": "number", "minimum": 0, "default": 0 },
          "volume_m3": { "type": "number", "minimum": 0, "default": 0 },
          "quantity": { "type": "integer", "minimum": 1, "default": 1 },
          "time_window_start": { "type": "string", "format": "date-time" },
          "time_window_end": { "type": "string", "format": "date-time" },
          "service_time_min": { "type": "number", "minimum": 0, "default": 5 },
          "priority": { "type": "integer", "minimum": 1, "default": 1 },
          "notes": { "type": "string" }
        }
      }
    },
    "depot": {
      "type": "object",
      "required": ["lat", "lng"],
      "properties": {
        "name": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "address": { "type": "string" },
        "departure_time": { "type": "string", "format": "date-time" },
        "return_time": { "type": "string", "format": "date-time" }
      }
    },
    "vehicles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "count"],
        "properties": {
          "type": { "type": "string", "description": "车型名称" },
          "count": { "type": "integer", "minimum": 1 },
          "capacity_kg": { "type": "number", "minimum": 0 },
          "capacity_m3": { "type": "number", "minimum": 0 }
        }
      }
    },
    "rules": {
      "type": "object",
      "description": "可选人工规则",
      "properties": {
        "inseparable_orders": {
          "type": "array",
          "items": { "type": "array", "items": { "type": "string" } },
          "description": "不可分装的订单组，每组订单必须同车配送"
        },
        "vehicle_order_assignments": {
          "type": "object",
          "description": "指定某些订单必须或不能由特定车型配送"
        }
      }
    }
  }
}
