# ===========================================
# ChainFlow 环境变量
# 复制此文件为 .env.local 并填入真实值
# .env.local 已在 .gitignore 中，不会提交 Git
# ===========================================

# Supabase（认证 + 数据库）
# 在 https://supabase.com 创建项目后获取
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# DeepSeek LLM（AI 排线管道的演示 Key）
# 在 https://platform.deepseek.com/api_keys 免费申请
# 用户可在页面中配置自己的 Key 替代演示 Key
DEEPSEEK_DEMO_KEY=sk-your-deepseek-key

# 应用基础 URL
# 开发环境：http://localhost:3000
# 生产环境：https://chainflowlab.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===========================================
# 第三方登录配置（可选）
# 未配置时登录页会显示"待配置"，不影响邮箱登录
# ===========================================

# 微信开放平台（网站应用）
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=
# 启用后在 .env.local 添加 NEXT_PUBLIC_WECHAT_ENABLED=true

# 钉钉开放平台（企业内部应用）
# DINGTALK_CLIENT_ID=
# DINGTALK_CLIENT_SECRET=
# 启用后在 .env.local 添加 NEXT_PUBLIC_DINGTALK_ENABLED=true

# ===========================================
# 以下为可选配置
# ===========================================

# 飞书（V1.0 再启用）
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=

# 支付宝（V1.0 再启用）
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
